# Port dan Host Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Secret Kunci (Wajib diganti di production: buat dengan `openssl rand -hex 32`)
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=12h
TRUST_PROXY=

# Akun Superadmin Awal
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Mode Penyimpanan Database (mysql atau json)
DB_TYPE=json
DB_FALLBACK_JSON=true
DATA_DIR=

# Konfigurasi MySQL (Bila DB_TYPE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pppoe_user
DB_PASSWORD=
DB_NAME=pppoe_manager
DB_POOL_SIZE=10
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=3000

# Mode Demo (Menyediakan router simulasi untuk pengujian tanpa perangkat fisik)
ENABLE_DEMO=false

# Konfigurasi Keamanan & Rate Limit
LOGIN_MAX_FAILURES_PER_IP=8
LOGIN_MAX_FAILURES_PER_USER=20
LOGIN_LOCK_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=900

# Pengaturan Koneksi Router MikroTik
ROUTER_CONNECT_TIMEOUT_MS=5000
ROUTER_COMMAND_TIMEOUT_MS=12000
ROUTER_OP_TIMEOUT_MS=15000
ROUTER_POOL_SIZE=3
ROUTER_IDLE_CLOSE_MS=45000
ROUTEROS_TLS_VERIFY=false
ROUTEROS_TLS_CIPHERS=

# Logging
LOG_LEVEL=info
LOG_FORMAT=text
